# ---------------------------------------------------------------------------
# Foreman — copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- nhost project (Dashboard -> your project -> Overview) ------------------
# e.g. NEXT_PUBLIC_NHOST_SUBDOMAIN=abcdefghijklmnopqrst
NEXT_PUBLIC_NHOST_SUBDOMAIN=
# e.g. ap-south-1, eu-central-1, us-east-1
NEXT_PUBLIC_NHOST_REGION=

# --- Hasura admin secret (Dashboard -> Settings -> Hasura) ------------------
# Server-side only. Used by the Action/Event handlers to write run state that
# the caller's own role is not allowed to write directly.
HASURA_GRAPHQL_ADMIN_SECRET=

# --- Shared secret between Hasura and this app's handlers -------------------
# Any long random string. Set the SAME value as a Hasura env var named
# ACTION_SECRET (Dashboard -> Settings -> Environment Variables); every Action
# and Event Trigger forwards it as the x-foreman-action-secret header, and the
# handlers reject requests that do not carry it.
ACTION_SECRET=

# --- Public base URL Hasura uses to reach these handlers --------------------
# Set as a Hasura env var named ACTION_BASE_URL (NOT read by this app).
# Production: https://<your-app>.vercel.app
# Local dev:  the https URL of a tunnel pointing at http://localhost:3000
# Listed here only so reviewers know it must exist on the Hasura side.
# ACTION_BASE_URL=

# --- LLM (Groq) -------------------------------------------------------------
# Optional. If GROQ_API_KEY is empty, llm_call steps run a clearly-logged stub
# with an artificial delay instead of a real API call.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- notify step ------------------------------------------------------------
# Optional. If empty, notify steps log a disclosed stub instead of posting.
SLACK_WEBHOOK_URL=

# --- Seed script only (scripts/seed.ts, scripts/test-cross-org.ts) ----------
# Password used for the generated demo accounts.
SEED_PASSWORD=Foreman!2026
